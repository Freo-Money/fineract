<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <!--
        interestRateFrequencyType=0 (per day) is accepted by the API but 0002_initial_data only seeded
        ids 2 and 3, so report joins on r_enum_value returned NULL for per-day rate products.
    -->
    <changeSet author="fineract" id="1">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM r_enum_value WHERE enum_name = 'interest_period_frequency_enum' AND enum_id = 0</sqlCheck>
        </preConditions>
        <insert tableName="r_enum_value">
            <column name="enum_name" value="interest_period_frequency_enum"/>
            <column name="enum_id" valueNumeric="0"/>
            <column name="enum_message_property" value="Per day"/>
            <column name="enum_value" value="Per day"/>
            <column name="enum_type" valueBoolean="false"/>
        </insert>
    </changeSet>
</databaseChangeLog>
