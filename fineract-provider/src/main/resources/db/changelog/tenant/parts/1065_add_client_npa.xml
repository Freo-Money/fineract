    <!-- fr_client_npa_status: current NPA state, one row per client -->
    <changeSet author="fineract" id="1065-1-postgresql" context="postgresql">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="fr_client_npa_status"/>
            </not>
        </preConditions>
        <createTable tableName="fr_client_npa_status">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="client_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_fr_client_npa_status_client"/>
            </column>
            <column name="is_npa" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="npa_start_date" type="DATE"/>
            <column name="trigger_loan_id" type="BIGINT"/>
            <column name="movement_type" type="VARCHAR(20)"/>
            <column name="exit_strategy" type="VARCHAR(50)"/>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_on_utc" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on_utc" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="fr_client_npa_status" baseColumnNames="client_id"
                                 referencedTableName="m_client" referencedColumnNames="id"
                                 constraintName="fk_fr_client_npa_status_client"/>
        <addForeignKeyConstraint baseTableName="fr_client_npa_status" baseColumnNames="trigger_loan_id"
                                 referencedTableName="m_loan" referencedColumnNames="id"
                                 constraintName="fk_fr_client_npa_status_trigger_loan"/>
        <createIndex tableName="fr_client_npa_status" indexName="idx_fr_client_npa_status_is_npa">
            <column name="is_npa"/>
        </createIndex>
    </changeSet>
