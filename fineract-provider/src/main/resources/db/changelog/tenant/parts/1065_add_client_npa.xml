    <changeSet author="fineract" id="1065-7" context="postgresql">
        <sql>
            SELECT SETVAL('c_configuration_id_seq', COALESCE(MAX(id), 0)+1, false ) FROM c_configuration;
        </sql>
    </changeSet>
    <changeSet author="fineract" id="1065-8">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">select count(1) from c_configuration where name = 'enable-client-npa'</sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="enable-client-npa"/>
            <column name="value"/>
            <column name="date_value"/>
            <column name="string_value"/>
            <column name="enabled" valueBoolean="false"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description"
                    value="When enabled: automatic client-NPA entry/exit/re-mapping (nightly UPDATE_NPA job reconcile + close/disburse-triggered re-eval; the per-loan COB step stays loan-level only). Contagion sets loan.is_npa on all active client loans. When disabled: no auto entry/exit/re-map, but stored fr_client_npa_status.is_npa stays effective (loan flags kept; new disbursements still sync; no exit until re-enabled)."/>
        </insert>
    </changeSet>
    <changeSet author="fineract" id="1065-9">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">select count(1) from c_configuration where name = 'client-npa-exit-strategy'</sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="client-npa-exit-strategy"/>
            <column name="value"/>
            <column name="date_value"/>
            <column name="string_value" value="ANY_NPA_LOAN_EXISTS"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description"
                    value="Auto-exit strategy when enable-client-npa is on. ANY_NPA_LOAN_EXISTS=exit when no active loan is independently NPA (arrears below threshold may remain). ALL_ARREARS_CLEARED=exit only when no active loan has arrears aging. STAY_NPA=never auto-exit."/>
        </insert>
    </changeSet>

    <changeSet author="fineract" id="1065-10">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">select count(1) from c_configuration where name = 'npa-transaction-processing-strategy'</sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="npa-transaction-processing-strategy"/>
            <column name="value"/>
            <column name="date_value"/>
            <column name="string_value" value="mifos-standard-strategy"/>
            <column name="enabled" valueBoolean="false"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description"
                    value="Repayment transaction processing strategy code (ref_loan_transaction_processing_strategy) used when loan.is_npa is true at posting time (covers loan-level NPA and client-NPA contagion). Independent of enable-client-npa."/>
        </insert>
    </changeSet>

    <!-- Config rows are mandatory: with external events enabled, posting an event type that has no
         m_external_event_configuration row throws ExternalEventConfigurationNotFoundException.
         One changeset per row: the PK is `type`, so a shared precondition would either PK-violate or
         MARK_RAN-skip the other rows on a database that already carries some of them. -->
    <changeSet author="fineract" id="1065-12">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">select count(1) from m_external_event_configuration where type = 'ClientEnteredNpaBusinessEvent'</sqlCheck>
        </preConditions>
        <insert tableName="m_external_event_configuration">
            <column name="type" value="ClientEnteredNpaBusinessEvent"/>
            <column name="enabled" valueBoolean="false"/>
        </insert>
    </changeSet>
